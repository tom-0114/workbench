PORT=3002
DATABASE_URL=postgres://workbench:change-me@127.0.0.1:5432/workbench
AUTH_USERNAME=admin
AUTH_COOKIE_PATH=/workbench
# echo -n 'your-password' | sha256sum
AUTH_PASSWORD_SHA256=replace-with-the-password-sha256
# 至少 32 个随机字符，例如：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret
