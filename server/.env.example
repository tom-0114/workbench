PORT=3002
DATABASE_URL=postgres://workbench:change-me@127.0.0.1:5432/workbench
# 以下两项仅在库中没有管理员时用于创建首个管理员，之后以数据库为准
AUTH_USERNAME=admin
AUTH_COOKIE_PATH=/workbench
# echo -n 'your-password' | sha256sum
AUTH_PASSWORD_SHA256=replace-with-the-password-sha256
# 至少 32 个随机字符，例如：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret
# 提醒推送（可选，不配则不推送）。生成密钥：cd server && node -e "import('./webpush.mjs').then(m=>console.log(m.generateVapidKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 推送服务要求的联系方式，填你自己的邮箱或网站，如 mailto:you@example.com
VAPID_SUBJECT=
